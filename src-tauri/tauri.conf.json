{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sirtuti",
  "version": "0.5.0",
  "identifier": "io.github.joka7.sirtuti",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "שרטוטי",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Dimensioned sketches for site visits",
    "longDescription": "Draw rooms and lots with dimensions, get area and perimeter for each shape, and export a clean sketch for price quotes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
